{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":["^Tri dni po Rade popola dorazila prvá správa z východu.","\n","^Prvý pluk Koruny prekročil rieku Eren.","\n","^Nebola to invázia.","\n","^Aspoň nie podľa Arkenu.","\n","^Oficiálne išlo o „ochranné cvičenie“.","\n","#","^character: Taren","/#","^„Mám rád vojenské názvy. Keď niekto povie ochranné cvičenie, vždy si skontroluj, či na teba nemieri kopija.“","\n","^Na nádvorí sa pripravovali jazdci.","\n","^Nymar však sledoval juh.","\n","^Asterov kryštál od rána pulzoval.","\n","ev",{"VAR?":"tajomstvo"},8,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Vedel si už, že južný signál sa zosilňuje zakaždým, keď Koruna aktivuje väčšie množstvo umelých pút.","\n",{"->":".^.^.^.27"},null]}],"nop","\n",{"->":"rozkaz"},null],"rozkaz":["^Avar vám dal nečakanú úlohu.","\n","#","^character: Rektor Avar","/#","^„Nechcem, aby ste leteli na front.“","\n","^Merovan protestoval.","\n","#","^character: Generál Merovan","/#","^„Sú to naši najskúsenejší kadeti.“","\n","#","^character: Nymar","/#","^„To je deprimujúca veta.“","\n","^Avar položil na stôl mapu.","\n","^Na juhu bola prázdna plocha.","\n","#","^character: Rektor Avar","/#","^„Nájdite zdroj signálu.“","\n","ev",{"VAR?":"vzdor"},8,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Pri stole sedel aj zástupca novovzniknutej Dračej rady, starý zelený drak Oth.","\n","#","^character: Oth","/#","^„A vrátite sa, ak sa rozhodnete vrátiť. Nie preto, že vám to prikazujeme.“","\n","^Merovan prevrátil oči.","\n",{"->":"rozkaz.34"},null]}],"nop","\n",{"->":"odlet"},null],"odlet":["^Leteli ste na juh: ty s Nymarom, Lyra so Sareth, Taren s Rokom a Edran na Varovi.","\n","^Po dvoch dňoch sa krajina zmenila na červenú pustatinu.","\n","^Kompas sa začal otáčať.","\n","^Mapy prestali sedieť.","\n","#","^character: Lyra","/#","^„Hora pred nami by nemala existovať.“","\n","#","^character: Taren","/#","^„Konečne niečo, čo zodpovedá našim skúsenostiam.“","\n","^Hora mala dokonale zrezaný vrchol.","\n","^A na ňom stálo mesto.","\n",{"->":"mesto"},null],"mesto":["^Mesto bolo opustené.","\n","^Budovy boli obrovské, postavené pre tvory väčšie než ľudia.","\n","^Pre draky.","\n","^Nymar pristál na širokom námestí.","\n","#","^character: Nymar","/#","^„Toto postavili moji.“","\n","#","^player: Ty","/#","^„Ako staré je to?“","\n","^Edran sa dotkol kamennej steny.","\n","#","^character: Majster Edran","/#","^„Staršie než všetky ľudské kráľovstvá.“","\n","ev",{"VAR?":"tajomstvo"},7,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Na stenách si spoznal symboly z komory pod Vaelgardom.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"mesto.31"},null]}],"nop","\n",{"->":"archiv"},null],"archiv":["^V strede mesta stála kupola.","\n","^Vo vnútri sa nachádzali tisíce kamenných tabúľ.","\n","^Nymar prečítal prvú.","\n","^Potom druhú.","\n","^Pri tretej prestal.","\n","#","^player: Ty","/#","^„Čo tam je?“","\n","#","^character: Nymar","/#","^„Mená.“","\n","#","^player: Ty","/#","^„Koho?“","\n","#","^character: Nymar","/#","^„Ľudí.“","\n","^Lyra sa zamračila.","\n","#","^character: Lyra","/#","^„V dračom meste?“","\n","^Nymar pokračoval v čítaní.","\n","#","^character: Nymar","/#","^„Prví jazdci.“","\n",{"->":"povod"},null],"povod":["^Záznamy rozprávali príbeh starší než Vaelgard.","\n","^Tichí prišli prvýkrát pred viac než tisíc rokmi.","\n","^Draky sa pred nimi nedokázali ukryť, pretože ich myseľ žiarila v rezonancii ako maják.","\n","^Potom jeden drak objavil niečo zvláštne.","\n","^Ľudská myseľ dokázala dračí signál rozptýliť.","\n","^Nie ovládnuť.","\n","^Skryť.","\n","#","^character: Edran","/#","^„Preto vzniklo puto.“","\n","#","^character: Lyra","/#","^„Draci si vybrali ľudí.“","\n","#","^character: Nymar","/#","^„Nie ako jazdcov.“","\n","^Nymar sa pozrel na teba.","\n","#","^character: Nymar","/#","^„Ako štíty.“","\n",{"->":"cena"},null],"cena":[["^Ďalšie tabule opisovali cenu.","\n","^Čím dlhšie boli druhy prepojené, tým viac sa systém menil.","\n","^Ľudia začali puto používať na velenie.","\n","^Draky začali zabúdať, prečo vôbec vzniklo.","\n","^Nakoniec bola postavená Kotva, aby stabilizovala tisíce pút naraz.","\n","^A z ochrany vznikla inštitúcia.","\n","#","^character: Taren","/#","^„Takže obe strany zabudli polovicu príbehu.“","\n","#","^character: Edran","/#","^„Ako väčšina dejín.“","\n","ev","str","^Spýtať sa Nymara, či by si ťa vybral aj bez hrozby Tichých.","/str",{"VAR?":"puto"},7,">=","/ev",{"*":".^.c-0","flg":21},"ev","str","^Pokračovať v hľadaní záznamov o Korune.","/str",{"VAR?":"tajomstvo"},8,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^Preskúmať spodné poschodia.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n",{"->":"osobna_otazka"},{"#f":5}],"c-1":["\n",{"->":"koruna_povod"},{"#f":5}],"c-2":["\n",{"->":"podzemie"},{"#f":5}]}],null],"osobna_otazka":["#","^player: Ty","/#","^„Keby Tichí nikdy neexistovali... vybral by si si ma?“","\n","^Nymar zostal nezvyčajne dlho ticho.","\n","#","^character: Nymar","/#","^„Na začiatku? Neviem.“","\n","^Otočil hlavu k tebe.","\n","#","^character: Nymar","/#","^„Teraz áno.“","\n","ev",{"VAR?":"puto"},9,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Pocítil si odpoveď skôr, než ju vyslovil. Nebola v nej povinnosť ani stará mágia.","\n","^Iba rozhodnutie.","\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":".^.^.^.25"},null]}],"nop","\n",{"->":"podzemie"},null],"koruna_povod":["^V najstaršej časti archívu si našiel kresbu kruhu takmer totožného s Korunou.","\n","#","^player: Ty","/#","^„Edran.“","\n","^Pozrel sa na kresbu a zbledol.","\n","#","^character: Edran","/#","^„Arken nevynašiel umelú rezonanciu.“","\n","^Text pod diagramom preložil Nymar.","\n","#","^character: Nymar","/#","^„Núdzové puto. Použiť iba so súhlasom oboch.“","\n","^Lyra pochopila.","\n","#","^character: Lyra","/#","^„Koruna odstránila súhlas.“","\n","ev",{"VAR?":"tajomstvo"},2,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"podzemie"},null],"podzemie":["^Pod mestom ste našli stroj.","\n","^Nie Kotvu.","\n","^Nie Korunu.","\n","^Sieť tisícov kryštálov prepojených cez celú horu.","\n","^Asterov kryštál sa rozžiaril tak silno, že ho bolo treba položiť na zem.","\n","#","^character: Edran","/#","^„Toto je zdroj signálu.“","\n","#","^character: Nymar","/#","^„Nie.“","\n","^Pristúpil bližšie.","\n","#","^character: Nymar","/#","^„Toto na signál odpovedá.“","\n","^Potom sa stroj zapol.","\n",{"->":"hlas"},null],"hlas":["^Všetky kryštály naraz vydali tón.","\n","^A v tvojej mysli sa objavil hlas.","\n","^Nie Tichý.","\n","^Dračí.","\n","#","^character: Neznámy hlas","/#","^„Ak toto počujete, ochranná sieť zlyhala.“","\n","^Nymar stratil farbu v šupinách.","\n","#","^character: Hlas","/#","^„Nespájajte Kotvy. Nezosilňujte rezonanciu. Tichí sledujú jednotný signál.“","\n","^Lyra sa pozrela na Edrana.","\n","#","^character: Lyra","/#","^„Koruna robí presný opak.“","\n","#","^character: Hlas","/#","^„Prežiť možno iba ako sieť bez stredu.“","\n",{"->":"utok"},null],"utok":["^Nad mestom zahrmelo.","\n","^Asterov kryštál praskol.","\n","^Nymar zdvihol hlavu.","\n","#","^character: Nymar","/#","^„Niečo prichádza.“","\n","^Neboli to Tichí.","\n","^Na oblohe sa objavilo dvanásť drakov.","\n","^Na ich chrbtoch sedeli jazdci v bielych prilbách.","\n","^Koruna.","\n","^Prvý pluk vás našiel.","\n","#","^character: Taren","/#","^„Takže ochranné cvičenie doletelo veľmi ďaleko.“","\n",{"->":"velitelka"},null],"velitelka":["^Pred formáciou pristála žena na čiernom drakovi.","\n","^Drak mal okolo hlavy kovový veniec.","\n","^Jeho oči boli otvorené, ale prázdne.","\n","#","^character: Veliteľka Koruny","/#","^„Odovzdajte archív.“","\n","#","^player: Ty","/#","^„Kto ste?“","\n","#","^character: Veliteľka Koruny","/#","^„Veliteľka Sera Veyn.“","\n","^Edran stuhol.","\n","#","^character: Edran","/#","^„Veyrova dcéra.“","\n","^Sera zosadla.","\n","#","^character: Sera","/#","^„Vaelgard držal toto poznanie stáročia pre seba. My ho dáme všetkým.“","\n","^Nymar ukázal zuby.","\n","#","^character: Nymar","/#","^„Spýtala si sa jeho?“","\n","^Čierny drak nereagoval.","\n",{"->":"volba_stret"},null],"volba_stret":[["ev",{"VAR?":"sucit"},7,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^V prázdnom pohľade čierneho draka si si spomenul na Iri, Caela a všetkých, ktorých Koruna použila.","\n",{"->":".^.^.^.6"},null]}],"nop","\n","ev","str","^Ukázať Sere pôvodný záznam: Koruna je poškodená verzia núdzového puta.","/str",{"VAR?":"tajomstvo"},9,">=","/ev",{"*":".^.c-0","flg":21},"ev","str","^Skúsiť cez Nymara osloviť čierneho draka.","/str",{"VAR?":"puto"},8,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^Nalákať jednotku Koruny nad kryštálovú sieť a narušiť ich centrálnu rezonanciu.","/str",{"VAR?":"rozum"},8,">=","/ev",{"*":".^.c-2","flg":21},"ev","str","^Postaviť sa Sere vo vzdušnom súboji.","/str",{"VAR?":"odvaha"},8,">=","/ev",{"*":".^.c-3","flg":21},"ev","str","^Ustúpiť do podzemia.","/str","/ev",{"*":".^.c-4","flg":20},{"c-0":["\n",{"->":"sera_dokaz"},{"#f":5}],"c-1":["\n",{"->":"cierny_drak"},{"#f":5}],"c-2":["\n",{"->":"pasca_koruna"},{"#f":5}],"c-3":["\n",{"->":"suboj"},{"#f":5}],"c-4":["\n",{"->":"obliehanie"},{"#f":5}]}],null],"sera_dokaz":["^Hodil si pred Seru kamennú kópiu diagramu.","\n","#","^player: Ty","/#","^„Prečítaj si poznámku.“","\n","^Sera sa zasmiala.","\n","#","^character: Sera","/#","^„Dračie písmo nečítam.“","\n","#","^character: Nymar","/#","^„Ja áno.“","\n","^Preložil vetu.","\n","^Použiť iba so súhlasom oboch.","\n","^Sera na okamih zaváhala.","\n","ev",{"VAR?":"tajomstvo"},11,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Ukázal si jej aj záznam o Tichých.","\n","#","^player: Ty","/#","^„Vaša sieť ich priťahuje.“","\n","^Nad mestom zhaslo slnko.","\n","^Sera konečne zdvihla oči.","\n",{"->":"prichod_tichych"},{"->":".^.^.^.32"},null]}],[{"->":".^.b"},{"b":["\n","^Sera rozkaz neodvolala.","\n",{"->":"cierny_drak"},{"->":".^.^.^.32"},null]}],"nop","\n",null],"cierny_drak":["^Nymar zavrel oči.","\n","#","^character: Nymar","/#","^„Počuje ma.“","\n","#","^player: Ty","/#","^„Dokáže odpovedať?“","\n","#","^character: Nymar","/#","^„Koruna ho tlačí pod hladinu.“","\n","ev",{"VAR?":"puto"},10,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Vložil si do spojenia aj vlastnú myseľ.","\n","^Nie rozkaz.","\n","^Otvorené dvere.","\n","^Čierny drak zrazu zažmurkal.","\n","#","^character: Čierny drak","/#","^„Volám sa Khar.“","\n","^Sera cúvla.","\n","#","^character: Sera","/#","^„To nie je možné.“","\n","^Khar sklonil hlavu a kovový veniec praskol.","\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"vzbura"},{"->":".^.^.^.24"},null]}],[{"->":".^.b"},{"b":["\n","^Khar sa zachvel, ale veniec vydržal.","\n",{"->":"boj"},{"->":".^.^.^.24"},null]}],"nop","\n",null],"pasca_koruna":["^Lyra pochopila plán okamžite.","\n","^Staré mesto používalo distribuovanú sieť. Koruna mala centrálny rytmus.","\n","^Keď jednotka preletela nad kryštálovým poľom, Edran aktivoval starý systém.","\n","^Koruny začali blikať každá inak.","\n","^Jazdci stratili koordináciu.","\n","^Draky nie.","\n","^Prvýkrát sa začali pohybovať podľa vlastnej vôle.","\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"vzbura"},null],"suboj":[["^Nymar vyrazil proti Kharovi.","\n","^Sera bola výborne vycvičená.","\n","^Ale bojovala proti tebe aj proti vlastnému drakovi.","\n","^Pri treťom obrate Khar úmyselne neposlúchol.","\n","^Sera stratila výhodu.","\n","#","^character: Nymar","/#","^„On nechce bojovať.“","\n","ev","str","^Prerušiť útok.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Pokračovať proti Sere, nie proti Kharovi.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"cierny_drak"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"boj"},{"#f":5}]}],null],"obliehanie":["^Stiahli ste sa pod zem.","\n","^Koruna obsadila námestie.","\n","^Mali ste archív, ale nie cestu von.","\n","^Taren sa pozrel na kryštálovú sieť.","\n","#","^character: Taren","/#","^„Prosím povedzte, že starí draci postavili aj tajný východ.“","\n","^Nymar prečítal značku na stene.","\n","#","^character: Nymar","/#","^„Postavili.“","\n","#","^character: Taren","/#","^„Začínam ich mať rád.“","\n","^Tunel vás však doviedol priamo pod jednotku Koruny.","\n",{"->":"pasca_koruna"},null],"boj":["^Sareth a Rok zaútočili na kovové vence, nie na draky.","\n","^Jeden po druhom praskali.","\n","^Každý oslobodený drak prestal bojovať.","\n","^Niektorí zhodili jazdcov do piesku. Iní iba pristáli.","\n","^Sera kričala rozkazy, ktoré už nikto neplnil.","\n",{"->":"vzbura"},null],"vzbura":["^Khar stál oproti Sere.","\n","#","^character: Sera","/#","^„Ja som ťa zachránila.“","\n","#","^character: Khar","/#","^„Nie.“","\n","^Jeho hlas bol slabý, ale zreteľný.","\n","#","^character: Khar","/#","^„Ty si ma dostala.“","\n","^Sera spustila zbraň.","\n","^Potom sa obloha zatiahla.","\n","^Nie mrakmi.","\n",{"->":"prichod_tichych"},null],"prichod_tichych":[["^Tichí prišli v desiatkach.","\n","^Koruna ich priviedla priamo k mestu.","\n","^Starý obranný systém sa rozžiaril.","\n","#","^character: Edran","/#","^„Sieť bez stredu! Musíme spojiť všetkých drakov, ale nikoho nesmieme prinútiť.“","\n","^Bývalí draci Koruny boli vystrašení.","\n","^Niektorí ľudským jazdcom neverili.","\n","ev",{"VAR?":"sucit"},8,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Cael, Iri a všetky tvoje predchádzajúce rozhodnutia ti pripomenuli jednu vec: dôvera sa nedá urýchliť.","\n",{"->":".^.^.^.21"},null]}],"nop","\n","ev","str","^Požiadať draky o pomoc bez podmienok.","/str",{"VAR?":"sucit"},8,">=",{"VAR?":"puto"},8,">=","&&","/ev",{"*":".^.c-0","flg":21},"ev","str","^Rozdeliť sieť na malé nezávislé skupiny.","/str",{"VAR?":"rozum"},9,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^Aktivovať celý systém naraz.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n",{"->":"dobrovolna_siet"},{"#f":5}],"c-1":["\n",{"->":"distribuovana_siet"},{"#f":5}],"c-2":["\n",{"->":"riziko"},{"#f":5}]}],null],"dobrovolna_siet":["^Nymar prehovoril k ostatným drakom.","\n","#","^character: Nymar","/#","^„Nežiadame vás, aby ste nám verili.“","\n","^Pozrel na Tichých.","\n","#","^character: Nymar","/#","^„Žiadame vás, aby ste sa rozhodli.“","\n","^Khar sa pripojil prvý.","\n","^Potom druhý drak.","\n","^Tretí.","\n","^Nakoniec všetci okrem jedného.","\n","^A to stačilo.","\n","ev",{"VAR?":"puto"},2,"+",{"VAR=":"puto","re":true},"/ev",{"->":"obrana_mesta"},null],"distribuovana_siet":["^Rozdelili ste drakov do trojíc.","\n","^Žiadne centrum.","\n","^Žiadny hlavný jazdec.","\n","^Žiadna Kotva.","\n","^Keď Tichí zaútočili na jeden uzol, ostatné pokračovali.","\n","^Starý systém presne na toto čakal tisíc rokov.","\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"obrana_mesta"},null],"riziko":["^Sieť sa zapla.","\n","^Na okamih fungovala.","\n","^Potom všetka rezonancia pretiekla cez Nymara.","\n","^Obaja ste padli.","\n","ev",{"VAR?":"zranenie"},2,"+",{"VAR=":"zranenie","re":true},"/ev","^Khar a Sareth však prevzali spojenie skôr, než sa sieť rozpadla.","\n",{"->":"obrana_mesta"},null],"obrana_mesta":["^Mesto sa rozžiarilo.","\n","^Nie jedným lúčom.","\n","^Tisíckami malých svetiel.","\n","^Tichí sa pokúsili nájsť centrum.","\n","^Žiadne nebolo.","\n","^Ich tvary sa rozpadli ako tiene pri východe slnka.","\n","^Jeden po druhom zmizli.","\n","^Keď bolo po všetkom, nikto neoslavoval.","\n","^Príliš veľa vecí sa práve zmenilo.","\n",{"->":"nasledky"},null],"nasledky":[["^Sera sedela pri rozbitej Korune.","\n","^Khar stál ďaleko od nej.","\n","#","^character: Sera","/#","^„Celý život mi hovorili, že Vaelgard drží draky v otroctve.“","\n","#","^character: Nymar","/#","^„Niekedy to bola pravda.“","\n","^Sera zdvihla hlavu.","\n","#","^character: Nymar","/#","^„To z vašej Koruny nerobí slobodu.“","\n","ev",{"VAR?":"sucit"},9,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","ev","str","^Ponúknuť Sere, aby sa vrátila do Vaelgardu ako svedok.","/str","/ev",{"*":".^.c-0","flg":20},{"->":".^.^.^.27"},{"c-0":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"navrat"},{"#f":5}]}]}],"nop","\n","ev","str","^Vziať ju ako zajatkyňu.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Nechať ju odísť bez Koruny.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"navrat"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"navrat"},{"#f":5}]}],null],"navrat":["^Pred návratom ste skopírovali čo najviac z archívu.","\n","^Najdôležitejšia veta bola krátka:","\n","#","^inscription","/#","^PUTO NIE JE REŤAZ.","\n","^PUTO NIE JE ROZKAZ.","\n","^PUTO JE DVOJHLASNÉ ROZHODNUTIE.","\n","^Nymar sa na nápis dlho díval.","\n","#","^character: Nymar","/#","^„Toto by mali vytesať nad bránu Vaelgardu.“","\n","#","^player: Ty","/#","^„Myslíš, že to bude stačiť?“","\n","#","^character: Nymar","/#","^„Nie.“","\n","^Roztiahol krídla.","\n","#","^character: Nymar","/#","^„Preto to bude dobrý začiatok.“","\n","#","^system","/#","^Kapitola X — Mesto bez mena — dokončená.","\n","done",null],"global decl":["ev",0,{"VAR=":"odvaha"},0,{"VAR=":"rozum"},0,{"VAR=":"sucit"},0,{"VAR=":"vzdor"},0,{"VAR=":"puto"},0,{"VAR=":"tajomstvo"},0,{"VAR=":"zranenie"},"str","^","/str",{"VAR=":"drak"},"str","^","/str",{"VAR=":"volba_cesty"},"/ev","end",null]}],"listDefs":{}}