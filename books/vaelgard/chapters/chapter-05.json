{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":[["^Tri týždne po udalostiach pri Kotve sa Vaelgard navonok vrátil k poriadku.","\n","^Navonok.","\n","^Na raňajkách stále zostávalo niekoľko miest prázdnych. Niektorí draci po zmene puta odleteli a ich bývalí jazdci akadémiu opustili. Iné dvojice zostali spolu, ale správali sa k sebe inak — opatrnejšie, akoby sa po rokoch prvýkrát naozaj stretli.","\n","^Nymar sedel na okraji letovej terasy a sledoval údolie.","\n","#","^character: Nymar","/#","^„Dnes nás pustia vysoko.“","\n","#","^player: Ty","/#","^„Tešíš sa?“","\n","#","^character: Nymar","/#","^„Ty nie?“","\n","^Prvý skutočný let mal viesť cez tri horské brány, ponad ľadovcové jazero a späť do Vaelgardu. Bez lana. Bez cvičnej plošiny. Bez inštruktora vedľa krídla.","\n","#","^character: Nymar","/#","^„Tvoje srdce je zase hlučné.“","\n","ev","str","^Priznať, že sa na let tešíš.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Prejsť si ešte raz trasu a núdzové postupy.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Spýtať sa Nymara, či chce vôbec letieť.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"nastup"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"nastup"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"chce_letiet"},{"#f":5}]}],null],"chce_letiet":["^Nymar sa na teba pozrel zboku.","\n","#","^character: Nymar","/#","^„Stále sa ma na to pýtaš.“","\n","#","^player: Ty","/#","^„Teraz môžem.“","\n","#","^character: Nymar","/#","^„Tak áno. Chcem.“","\n","^Roztiahol krídla.","\n","#","^character: Nymar","/#","^„A chcem byť prvý.“","\n",{"->":"nastup"},null],"nastup":["^Na hlavnej terase čakali Lyra so Sareth, Taren so svojím modrosivým Rokom a ďalších šesť dvojíc.","\n","^Inštruktorka Seris rozvinula mapu.","\n","#","^character: Inštruktorka Seris","/#","^„Prvá brána je jednoduchá. Druhá má bočný vietor. Za treťou sa rozdelíte do trojíc a vrátite sa cez jazero.“","\n","#","^character: Taren","/#","^„A čo sa pokazí?“","\n","#","^character: Inštruktorka Seris","/#","^„To je správna otázka.“","\n","^Seris ukázala na sever.","\n","#","^character: Inštruktorka Seris","/#","^„Búrka prichádza skôr, než hlásili pozorovatelia. Máte dve hodiny.“","\n","^Lyra si všimla tmavý pás mrakov.","\n","#","^character: Lyra","/#","^„Máme hodinu.“","\n","^Seris sa na ňu pozrela a prikývla.","\n",{"->":"vzlet"},null],"vzlet":[["^Nymar sa rozbehol.","\n","^Tentoraz neprišiel pád.","\n","^Keď skočil z terasy, presne si vedel, kedy otvorí krídla. Puto medzi vami už nebolo cudzím hlasom v hlave. Bolo priestorom, v ktorom ste sa obaja pohybovali.","\n","^Vaelgard sa pod vami zmenšil.","\n","^Prvá brána bola dvojica kamenných ihiel. Preleteli ste medzi nimi tak blízko, že si videl lišajníky na skale.","\n","#","^character: Nymar","/#","^„Rýchlejšie?“","\n","ev","str","^Áno. Skúsiť predbehnúť Tarena.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Držať formáciu.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Nechať Nymara vybrať tempo.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"preteky"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"druha_brana"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"nymar_tempo"},{"#f":5}]}],null],"preteky":[["^Rok prijal výzvu skôr než Taren.","\n","^Oba draky zrýchlili.","\n","#","^character: Taren","/#","^„Toto určite nie je porušenie pravidiel!“","\n","#","^player: Ty","/#","^„Určite je!“","\n","^Bočný vietor pri druhej bráne vás zasiahol v najhoršom okamihu.","\n","ev","str","^Stiahnuť Nymara pod prúd.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Preletieť cez náraz silou.","/str","/ev",{"*":".^.c-1","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"druha_brana"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":"zranenie"},1,"+",{"VAR=":"zranenie","re":true},"/ev",{"->":"druha_brana"},{"#f":5}]}],null],"nymar_tempo":["^Nymar spomalil.","\n","#","^player: Ty","/#","^„Čakal som, že zrýchliš.“","\n","#","^character: Nymar","/#","^„Prečo?“","\n","#","^player: Ty","/#","^„Povedal si, že chceš byť prvý.“","\n","#","^character: Nymar","/#","^„Chcem byť prvý doma. To je iná disciplína.“","\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"druha_brana"},null],"druha_brana":["^Za druhou bránou sa vzduch zmenil. Teplý prúd stúpal z údolia a studený padal zo štítov.","\n","^Lyra so Sareth sa naklonili doľava.","\n","#","^character: Lyra","/#","^„Mraky sú už nad Severnou stenou.“","\n","^V diaľke zablikalo.","\n","^Seris dala signál pokračovať k tretej bráne.","\n","^Potom sa ozval hrom.","\n","^Nie z oblohy.","\n","^Nymar prudko otočil hlavu k lesu pod vami.","\n","#","^character: Nymar","/#","^„Drak.“","\n","#","^player: Ty","/#","^„Kde?“","\n","#","^character: Nymar","/#","^„Dole. A bojí sa.“","\n",{"->":"signal"},null],"signal":[["^V lese sa medzi stromami objavil červený záblesk. Potom dym.","\n","^Seris dala signál: pokračovať podľa trasy.","\n","#","^character: Nymar","/#","^„Cítim mláďa.“","\n","ev","str","^Poslúchnuť Seris a pokračovať.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Odtrhnúť sa z formácie a ísť k lesu.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Signalizovať Seris a žiadať povolenie preskúmať dym.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"tretia_brana"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"les"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"povolenie"},{"#f":5}]}],null],"povolenie":["^Seris najprv ukázala návrat do formácie.","\n","^Nymar zareval.","\n","^Z lesa odpovedal slabší hlas.","\n","^Seris zmenila signál.","\n","^Ty, Lyra a Taren ste mali päť minút.","\n",{"->":"les"},null],"tretia_brana":["^Pokračovali ste k tretej bráne, ale Nymar bol nepokojný.","\n","^Keď ste ju preleteli, búrka už zakryla cestu späť.","\n","^Seris otočila celú skupinu.","\n","^Pri návrate ste nad lesom uvideli oheň.","\n","#","^character: Nymar","/#","^„Už tam ideme.“","\n","^Tentoraz si nenamietal.","\n",{"->":"les"},null],"les":[["^Pristáli ste na malej čistine.","\n","^Medzi stromami ležalo dračie mláďa. Jedno krídlo malo zachytené v kovovej sieti. Okolo boli stopy topánok.","\n","^Lyra si kľakla k mechanizmu.","\n","#","^character: Lyra","/#","^„Toto nie je lovecká pasca.“","\n","^Taren zdvihol kovový hrot.","\n","#","^character: Taren","/#","^„Má znak.“","\n","^Na hrote bola vyrytá koruna obklopená tromi hviezdami.","\n","^Nymar zavrčal.","\n","#","^character: Nymar","/#","^„Východné kniežatstvá.“","\n","ev","str","^Najprv vyslobodiť mláďa.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Najprv preskúmať okolie. Lovci môžu byť blízko.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Vyraziť po stopách okamžite.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},2,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"oslobodenie"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"stopy"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"prenasledovanie"},{"#f":5}]}],null],"oslobodenie":["^Sieť bola vyrobená tak, aby sa pri pohybe sťahovala.","\n","^Nymar držal mláďa pokojne, zatiaľ čo Lyra uvoľňovala kovové háky.","\n","#","^character: Nymar","/#","^„Volá sa Iri.“","\n","#","^player: Ty","/#","^„Poznáš ju?“","\n","#","^character: Nymar","/#","^„Nie. Povedala mi.“","\n","^Keď sieť povolila, Iri sa pritlačila k Nymarovi.","\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"stopy"},null],"stopy":["^Našli ste šesť rôznych odtlačkov topánok a hlboké ryhy po voze.","\n","#","^character: Lyra","/#","^„Nie sú ďaleko.“","\n","^Taren sa pozrel k oblohe.","\n","#","^character: Taren","/#","^„A my máme búrku, zranené mláďa a rozkaz vrátiť sa.“","\n","^Nymar zacítil vzduch.","\n","#","^character: Nymar","/#","^„Ďalšie draky.“","\n","#","^player: Ty","/#","^„Koľko?“","\n","#","^character: Nymar","/#","^„Najmenej tri.“","\n",{"->":"prenasledovanie"},null],"prenasledovanie":[["^Stopy viedli do úzkeho údolia.","\n","^Na jeho konci stáli dva vozy a tucet ozbrojených ľudí. V železných klietkach boli tri mladé draky.","\n","^Muž v červenom plášti zdvihol kuše.","\n","#","^character: Neznámy veliteľ","/#","^„Jazdci Vaelgardu. Toto nie je vaša zem.“","\n","^Lyra sa zasmiala bez humoru.","\n","#","^character: Lyra","/#","^„Sme dvadsať kilometrov od akadémie.“","\n","#","^character: Veliteľ","/#","^„Hranice sa menia.“","\n","ev","str","^Vyjednávať a získať čas.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Zaútočiť skôr, než strelci zamieria na draky.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Nechať Nymara hovoriť s uväznenými drakmi.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"vyjednavanie"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},2,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"utok_tabor"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"draci_plan"},{"#f":5}]}],null],"vyjednavanie":["#","^player: Ty","/#","^„Ak patríte Východným kniežatstvám, útok na kadetov Vaelgardu znamená vojnu.“","\n","^Veliteľ sa pousmial.","\n","#","^character: Veliteľ","/#","^„Kto hovorí o útoku? Odídete. My odídeme. Búrka zmaže stopy.“","\n","#","^player: Ty","/#","^„A draky?“","\n","#","^character: Veliteľ","/#","^„Majetok kniežaťa.“","\n","^Nymarov hnev prešiel putom ako oheň.","\n","#","^character: Nymar","/#","^„Povedz mu, že majetok nesúhlasí.“","\n","^Rozhovor vám však dal čas. Sareth a Rok sa nenápadne rozostúpili.","\n",{"->":"utok_tabor"},null],"draci_plan":["^Nymar zavrel oči.","\n","#","^character: Nymar","/#","^„Sú vystrašené, ale počujú ma.“","\n","#","^player: Ty","/#","^„Dokážu rozbiť klietky?“","\n","#","^character: Nymar","/#","^„Nie zvnútra.“","\n","^Lyra pochopila.","\n","#","^character: Lyra","/#","^„Zámky.“","\n","^Taren si prehodil meč.","\n","#","^character: Taren","/#","^„Konečne plán, ktorému rozumiem.“","\n",{"->":"utok_tabor"},null],"utok_tabor":[["^Prvý blesk udrel do hrebeňa.","\n","^V tom istom okamihu ste vyrazili.","\n","^Nymar preletel nízko nad vozmi. Strelci sa rozutekali. Sareth vyrazila zámok prvej klietky chvostom.","\n","^Taren zoskočil z Roka priamo medzi dvoch mužov.","\n","#","^character: Taren","/#","^„Toto je tá časť štúdia, ktorú som očakával!“","\n","^Veliteľ vytiahol krátku kušu a zamieril na Iri.","\n","ev","str","^Kryť mláďa vlastným telom.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Zakričať Nymarovi.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Hodiť po veliteľovi zbraň.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},2,"+",{"VAR=":"sucit","re":true},"/ev","ev",{"VAR?":"zranenie"},1,"+",{"VAR=":"zranenie","re":true},"/ev",{"->":"koniec_boja"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"puto"},2,"+",{"VAR=":"puto","re":true},"/ev",{"->":"nymar_zasah"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"koniec_boja"},{"#f":5}]}],null],"nymar_zasah":["^Nemusel si dokončiť vetu.","\n","^Nymar už vedel.","\n","^Jeho krídlo sa spustilo medzi kušu a mláďa. Šíp sa odrazil od šupín.","\n","^Nymar sa na teba pozrel.","\n","#","^character: Nymar","/#","^„Nemusel si hovoriť.“","\n","#","^player: Ty","/#","^„Viem.“","\n",{"->":"koniec_boja"},null],"koniec_boja":["^Keď dorazila Seris s ostatnými jazdcami, boj už končil.","\n","^Veliteľ utiekol do lesa, ale vozy zostali.","\n","^V jednom ste našli mapy, zásoby a list zapečatený tromi hviezdami.","\n","^Seris ho prečítala.","\n","^Jej tvár sa zmenila.","\n","#","^player: Ty","/#","^„Čo tam je?“","\n","#","^character: Inštruktorka Seris","/#","^„Rozkaz chytať mladé draky. Živé.“","\n","#","^character: Lyra","/#","^„Prečo?“","\n","^Seris zložila list.","\n","#","^character: Inštruktorka Seris","/#","^„Pretože niekto na východe sa pokúša vybudovať vlastný Vaelgard.“","\n",{"->":"navrat"},null],"navrat":["^Búrka vás chytila cestou späť.","\n","^Leteli ste v daždi tak hustom, že si nevidel koniec Nymarovho krídla. Navigovali ste takmer iba cez puto.","\n","^Keď sa konečne objavili svetlá akadémie, Nymar bol vyčerpaný.","\n","^Pristáli ste tvrdo.","\n","^Rektor Avar čakal na terase.","\n","^Seris mu podala list.","\n","^Avar ho prečítal a potom sa pozrel na severovýchod.","\n","#","^character: Rektor Avar","/#","^„Takže začali.“","\n","#","^player: Ty","/#","^„Kto?“","\n","#","^character: Rektor Avar","/#","^„Ľudia, ktorí celé stáročia tvrdili, že Vaelgard má priveľa moci.“","\n","#","^character: Nymar","/#","^„Možno mali pravdu.“","\n","^Avar sa naňho pozrel.","\n","#","^character: Rektor Avar","/#","^„Možno.“","\n","#","^system","/#","^Kapitola V — Prvý skutočný let — dokončená.","\n","done",null],"global decl":["ev",0,{"VAR=":"odvaha"},0,{"VAR=":"rozum"},0,{"VAR=":"sucit"},0,{"VAR=":"vzdor"},0,{"VAR=":"puto"},0,{"VAR=":"tajomstvo"},0,{"VAR=":"zranenie"},"str","^","/str",{"VAR=":"drak"},"str","^","/str",{"VAR=":"volba_cesty"},"/ev","end",null]}],"listDefs":{}}