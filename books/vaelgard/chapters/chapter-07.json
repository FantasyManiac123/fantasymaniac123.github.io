{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":["^Keď ste sa vrátili z Arkenu, brány Vaelgardu boli zatvorené.","\n","^Nie kvôli vám.","\n","^Na oblohe krúžili hliadky a na každej veži horeli signálne ohne. Nymar pristál na južnej terase medzi dvoma ozbrojenými oddielmi.","\n","#","^character: Nymar","/#","^„Toto nevyzerá ako privítanie.“","\n","^Seris vám vyšla v ústrety.","\n","#","^character: Inštruktorka Seris","/#","^„Kým ste boli preč, zmizli ďalšie dva mladé draky.“","\n","^Lyra jej podala dokumenty Projektu Koruna.","\n","#","^character: Lyra","/#","^„Potom vieme kam.“","\n","^Seris však pokrútila hlavou.","\n","#","^character: Inštruktorka Seris","/#","^„Nie. Tieto zmizli zvnútra Vaelgardu.“","\n",{"->":"rada"},null],"rada":[["^V zasadacej sieni sa tentoraz nikto nesťažoval na Nymarovu prítomnosť.","\n","^Na stole ležali mapy akadémie.","\n","#","^character: Rektor Avar","/#","^„Nikto neprelomil vonkajšie brány. Nikto nepreletel cez hliadky.“","\n","#","^player: Ty","/#","^„Tak ich niekto odviedol.“","\n","#","^character: Generál Merovan","/#","^„Alebo odišli.“","\n","^Nymar zavrčal.","\n","#","^character: Nymar","/#","^„Mláďatá neopustia hniezdisko uprostred noci bez dôvodu.“","\n","^Avar ukázal na starú časť akadémie.","\n","#","^character: Rektor Avar","/#","^„Podzemné chodby.“","\n","ev","str","^Preskúmať staré tunely.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Najprv vypočuť kadetov na nočnej službe.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Spýtať sa drakov, čo cítili.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"tunely"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"svedkovia"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"dracie_svedectvo"},{"#f":5}]}],null],"svedkovia":["^Kadet pri západnej veži tvrdil, že nič nevidel.","\n","^Druhý počul kovové údery pod podlahou.","\n","^Tretia kadetka sa zdráhala hovoriť.","\n","#","^player: Ty","/#","^„Čo si videla?“","\n","#","^character: Kadetka","/#","^„Majstra Edrana. Išiel do starej veže.“","\n","^Lyra zbledla.","\n","#","^character: Lyra","/#","^„Edran učí dejiny puta.“","\n",{"->":"tunely"},null],"dracie_svedectvo":["^Staršie draky sa zhromaždili na nádvorí.","\n","^Ich odpovede neboli rovnaké, ale jedna vec sa opakovala.","\n","^Strach.","\n","^Nie strach mláďat.","\n","^Cudzí strach, ktorý sa šíril cez putá.","\n","#","^character: Nymar","/#","^„Niekto používal rezonanciu.“","\n","#","^player: Ty","/#","^„Korunu?“","\n","#","^character: Nymar","/#","^„Niečo podobné.“","\n",{"->":"tunely"},null],"tunely":["^Vchod ste našli za starou mapou v učebni dejín.","\n","^Taren zdvihol lampu.","\n","#","^character: Taren","/#","^„Ak sa za stenou objaví kostra bývalého rektora, odchádzam.“","\n","#","^character: Lyra","/#","^„Prečo práve rektora?“","\n","#","^character: Taren","/#","^„Kostry učiteľov sú tematické.“","\n","^Tunel klesal hlboko pod akadémiu.","\n","^Na stenách boli staré dračie znaky.","\n","^Nymar sa ich dotýkal ňufákom.","\n","#","^character: Nymar","/#","^„Toto nie je ľudská chodba.“","\n",{"->":"komora"},null],"komora":["^Tunel sa otvoril do obrovskej kruhovej komory.","\n","^Uprostred stál kamenný kruh podobný Kotve — ale oveľa starší.","\n","^Pri ňom bol majster Edran.","\n","^A dve nezvestné mláďatá.","\n","#","^player: Ty","/#","^„Edran.“","\n","^Muž sa pomaly otočil.","\n","#","^character: Majster Edran","/#","^„Tak predsa ste našli cestu.“","\n","#","^character: Lyra","/#","^„Vy ste ich uniesli?“","\n","#","^character: Majster Edran","/#","^„Zachránil.“","\n","^Nymar sa postavil medzi Edrana a mláďatá.","\n","#","^character: Nymar","/#","^„Pred čím?“","\n","^Edran položil ruku na kameň.","\n","#","^character: Majster Edran","/#","^„Pred tým, čo prichádza.“","\n",{"->":"pravda"},null],"pravda":[["^Edran vysvetlil, že Kotva nebola prvým zariadením svojho druhu.","\n","^Pod Vaelgardom existoval starší systém.","\n","^Nie na ovládanie drakov.","\n","^Na ich ukrytie.","\n","#","^character: Majster Edran","/#","^„Pred tisíc rokmi neboli draky vládcami oblohy. Boli korisťou.“","\n","#","^player: Ty","/#","^„Koho?“","\n","^Edran sa pozrel nahor, akoby videl cez kilometre skaly.","\n","#","^character: Majster Edran","/#","^„Niečoho, čo sa vracia.“","\n","ev","str","^Neveriť mu a zatknúť ho.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Požiadať ho, aby ukázal dôkaz.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Nechať Nymara rozhodnúť, či mu verí.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"zatknutie"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"tajomstvo"},2,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"dokaz"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},2,"+",{"VAR=":"puto","re":true},"/ev",{"->":"nymar_sudi"},{"#f":5}]}],null],"zatknutie":["^Taren vykročil dopredu.","\n","^Edran nekládol odpor.","\n","^Potom sa kamenný kruh rozžiaril.","\n","^Mláďatá začali kričať.","\n","#","^character: Majster Edran","/#","^„Neskoro.“","\n",{"->":"prebudenie"},null],"dokaz":["^Edran stlačil tri kamene.","\n","^Stena komory sa otvorila.","\n","^Za ňou bola maľba staršia než akadémia.","\n","^Zobrazovala stovky drakov padajúcich z oblohy.","\n","^Nad nimi sa vznášali čierne tvary bez krídel.","\n","#","^character: Lyra","/#","^„Čo sú zač?“","\n","#","^character: Majster Edran","/#","^„Tichí.“","\n","^Nymar cúvol.","\n","#","^character: Nymar","/#","^„Poznám to slovo.“","\n",{"->":"prebudenie"},null],"nymar_sudi":["^Nymar dlho hľadel Edranovi do očí.","\n","#","^character: Nymar","/#","^„Bojíš sa.“","\n","#","^character: Majster Edran","/#","^„Áno.“","\n","#","^character: Nymar","/#","^„Ale nie nás.“","\n","^Edran prikývol.","\n","#","^character: Nymar","/#","^„Hovorí pravdu. Ale nie celú.“","\n","^Edran sa smutne usmial.","\n","#","^character: Majster Edran","/#","^„Draci sa učia rýchlo.“","\n",{"->":"prebudenie"},null],"prebudenie":["^Kameň pod vašimi nohami sa zachvel.","\n","^Všetky draky vo Vaelgarde naraz zarevali.","\n","^Cez puto ťa zasiahla Nymarova bolesť.","\n","^A potom niečo cudzie.","\n","^Tiché.","\n","^Chladné.","\n","^Vzdialené.","\n","#","^character: Nymar","/#","^„Niečo sa ma dotklo.“","\n","^Na kamennom kruhu sa objavil obraz severnej oblohy.","\n","^Jedna hviezda zhasla.","\n","^Potom druhá.","\n","#","^character: Majster Edran","/#","^„Začalo sa to.“","\n",{"->":"poplach"},null],"poplach":["^Vybehli ste z tunelov práve vo chvíli, keď zazneli zvony.","\n","^Na severe bola noc neprirodzene tmavá.","\n","^Draky odmietali vzlietnuť.","\n","^Niektoré sa tlačili k stenám.","\n","^Sareth sa triasla.","\n","#","^character: Lyra","/#","^„Nikdy som ju takú nevidela.“","\n","^Nymar sa prinútil roztiahnuť krídla.","\n","#","^character: Nymar","/#","^„Ja áno.“","\n","#","^player: Ty","/#","^„Kedy?“","\n","#","^character: Nymar","/#","^„V snoch.“","\n",{"->":"rozhodnutie"},null],"rozhodnutie":[["^Rada sa zišla na nádvorí.","\n","^Edran stál pod strážou.","\n","#","^character: Majster Edran","/#","^„Tichí lovia cez puto. Čím silnejšie puto, tým ľahšie vás nájdu.“","\n","^Merovan sa pozrel na Avara.","\n","#","^character: Generál Merovan","/#","^„Tak putá prerušíme.“","\n","^Draky okolo vás začali vrčať.","\n","#","^character: Nymar","/#","^„Skúste.“","\n","ev","str","^Odmietnuť akékoľvek nútené prerušenie puta.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Navrhnúť výpravu na sever a zistiť, čo sa deje.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Presvedčiť radu, aby najprv vypočula Edrana.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"vzdor"},2,"+",{"VAR=":"vzdor","re":true},"/ev","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"cesta_sever"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":