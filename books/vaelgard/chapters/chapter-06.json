{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":[["^Rada Vaelgardu zasadala po prvýkrát s drakmi.","\n","^Praktický problém sa ukázal okamžite: zasadacia sieň bola postavená pre ľudí.","\n","^Sareth mala hlavu prestrčenú cez otvorené okno. Rok ležal na nádvorí a Taren mu opakoval diskusiu cez puto. Nymar odmietol zostať vonku a zabral polovicu priestoru pri dverách.","\n","^Na stole ležal list z tábora lovcov.","\n","#","^character: Rektor Avar","/#","^„Východné kniežatstvá porušili dohodu z Arkenu.“","\n","^Starý generál Merovan udrel päsťou do stola.","\n","#","^character: Generál Merovan","/#","^„Tak odpovedzme silou.“","\n","#","^character: Nymar","/#","^„Koho silou?“","\n","^Generál sa otočil.","\n","#","^character: Generál Merovan","/#","^„Prosím?“","\n","#","^character: Nymar","/#","^„Keď hovoríš, že Vaelgard odpovie silou, myslíš ľudí aj drakov. Pýtal si sa drakov?“","\n","^V sále nastalo ticho.","\n","ev","str","^Podporiť Nymara.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Navrhnúť najprv prieskum.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Súhlasiť, že únosy drakov vyžadujú tvrdú odpoveď.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"spor_rady"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"prieskum"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"merovan"},{"#f":5}]}],null],"spor_rady":["#","^player: Ty","/#","^„Ak má byť toto nová rada, nemôžeme používať staré pravidlá zakaždým, keď sú pohodlné.“","\n","^Merovan si ťa premeral.","\n","#","^character: Generál Merovan","/#","^„Kadet poučuje radu o vojne.“","\n","#","^player: Ty","/#","^„Nie. Kadet pripomína rade, kto v tej vojne bude lietať.“","\n","^Nymar spokojne vydýchol dym.","\n",{"->":"prieskum"},null],"merovan":["#","^player: Ty","/#","^„Unášajú mláďatá. Nemôžeme čakať.“","\n","#","^character: Nymar","/#","^„Súhlasím.“","\n","^Generál sa takmer usmial.","\n","#","^character: Nymar","/#","^„Ale ja rozhodnem, či budem bojovať.“","\n","^Úsmev zmizol.","\n",{"->":"prieskum"},null],"prieskum":["^Rada rozhodla vyslať malú skupinu na hranicu.","\n","^Nie armádu. Kadetov.","\n","#","^character: Lyra","/#","^„To je buď prejav dôvery, alebo spôsob, ako sa nás zbaviť.“","\n","#","^character: Taren","/#","^„Prečo nie oboje?“","\n","^Vašou úlohou bolo dostať sa do mesta Arken, zistiť, kto organizuje lov drakov, a nevyvolať diplomatický incident.","\n","^Seris vám pri odchode zopakovala poslednú časť trikrát.","\n",{"->":"cesta"},null],"cesta":[["^Leteli ste dva dni na východ.","\n","^Krajina sa menila. Hory ustúpili zeleným pahorkom, dedinám a širokým cestám. Ľudia pri pohľade na draky neutekali, ale ani nemávali.","\n","^V prvej dedine hostinský odmietol ubytovať jazdcov.","\n","#","^character: Hostinský","/#","^„Draky zostanú za dedinou.“","\n","#","^character: Taren","/#","^„Rok je čistotnejší než ja.“","\n","#","^character: Hostinský","/#","^„Tomu verím.“","\n","ev","str","^Rešpektovať pravidlo a prespať pri drakoch vonku.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Zaplatiť za celú stajňu.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Pohádať sa s hostinským.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"noc_cesta"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"noc_cesta"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"klebety"},{"#f":5}]}],null],"klebety":["^Hádka pritiahla pozornosť miestnych.","\n","^Staršia žena pri peci si vás dlho prezerala.","\n","#","^character: Starena","/#","^„Ak ste z Vaelgardu, mali by ste vedieť, čo sa o vás hovorí.“","\n","#","^player: Ty","/#","^„Čo?“","\n","#","^character: Starena","/#","^„Že draky už neposlúchajú. Že akadémia padá. Že jazdci prídu zobrať našich synov do vojny.“","\n","^Lyra stuhla.","\n","#","^character: Lyra","/#","^„Kto to hovorí?“","\n","#","^character: Starena","/#","^„Poslovia kniežaťa.“","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"noc_cesta"},null],"noc_cesta":["^V noci si sedel pri Nymarovi.","\n","#","^character: Nymar","/#","^„Ľudia sa nás boja.“","\n","#","^player: Ty","/#","^„Drakov?“","\n","#","^character: Nymar","/#","^„Vaelgardu.“","\n","^Chvíľu ste sledovali oheň.","\n","#","^character: Nymar","/#","^„Možno je rozdiel menší, než si myslíte.“","\n",{"->":"arken"},null],"arken":["^Arken bol obohnaný bielymi hradbami a červenými strechami. Draky do mesta nesmeli.","\n","^Museli ste ich nechať na lúke pri starej pevnosti.","\n","#","^character: Nymar","/#","^„Nepáči sa mi to.“","\n","#","^player: Ty","/#","^„Mne tiež.“","\n","#","^character: Nymar","/#","^„Nie. Myslím mesto. Smrdí železom.“","\n","^Puto sa medzi vami natiahlo, keď si prešiel bránou.","\n","^Prvýkrát od Kotvy ste boli od seba tak ďaleko.","\n",{"->":"mesto"},null],"mesto":[["^Lyra chcela ísť do knižnice obchodníckeho cechu. Taren navrhoval krčmy pri kasárňach.","\n","ev","str","^Ísť s Lyrou po dokumentoch.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Ísť s Tarenom medzi vojakov.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Skúsiť cez trh zistiť, kto nakupuje kovové siete.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"kniznica"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"krcma"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"trh"},{"#f":5}]}],null],"kniznica":["^V cechových záznamoch ste našli objednávky na stovky kilogramov „leteckého zadržiavacieho zariadenia“.","\n","^Kupujúcim bola spoločnosť Ordan & Synovia.","\n","#","^character: Lyra","/#","^„Spoločnosť vznikla pred šiestimi mesiacmi.“","\n","#","^player: Ty","/#","^„Majiteľ?“","\n","^Lyra otočila register.","\n","#","^character: Lyra","/#","^„Nikto. Vlastní ju iná spoločnosť.“","\n","^Po hodine sledovania papierovej stopy ste skončili pri mene: kancelár Veyr, hlavný poradca kniežaťa.","\n","ev",{"VAR?":"tajomstvo"},2,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"spojenie"},null],"krcma":["^Taren nepotreboval veľa času.","\n","^Po dvoch kolách piva sa vojaci začali chváliť.","\n","#","^character: Vojak","/#","^„Knieža bude mať vlastných jazdcov. Nie tie vaelgardské bábky.“","\n","#","^player: Ty","/#","^„Ako chce prinútiť draky, aby si ich vybrali?“","\n","^Vojak sa usmial.","\n","#","^character: Vojak","/#","^„Naši učenci našli lepší spôsob.“","\n","^Taren pod stolom stisol päsť.","\n","ev",{"VAR?":"tajomstvo"},2,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"spojenie"},null],"trh":["^Kováč, ktorý vyrábal články sietí, najprv odmietal hovoriť.","\n","^Keď si mu ukázal poškodený hrot z pasce na Iri, zbledol.","\n","#","^character: Kováč","/#","^„Povedali mi, že sú na gryfy.“","\n","#","^player: Ty","/#","^„Kto?“","\n","#","^character: Kováč","/#","^„Ľudia kancelára Veyra.“","\n","#","^player: Ty","/#","^„Kde ich odvážajú?“","\n","^Kováč ukázal na severnú časť mesta.","\n","#","^character: Kováč","/#","^„Stará mincovňa.“","\n",{"->":"spojenie"},null],"spojenie":["^Všetky stopy viedli k starej mincovni.","\n","^Po zotmení ste sa stretli pri kanáli.","\n","#","^character: Lyra","/#","^„Veyr financuje lovcov.“","\n","#","^character: Taren","/#","^„A vojaci hovoria o vlastných jazdcoch.“","\n","#","^player: Ty","/#","^„Tak sa pozrime, čo razia v mincovni.“","\n",{"->":"mincovna"},null],"mincovna":["^Do budovy ste vošli starým odtokovým tunelom.","\n","^Vo vnútri neboli mince.","\n","^Boli tam laboratóriá.","\n","^Na kovových stoloch ležali kryštály podobné tým z Kotvy. V klietkach za sklom boli dračie šupiny, krv a kúsky kostí.","\n","^Lyra sa musela oprieť o stenu.","\n","#","^character: Lyra","/#","^„Pokúšajú sa Kotvu napodobniť.“","\n","^Z vedľajšej miestnosti sa ozval výkrik.","\n","^Nie ľudský.","\n",{"->":"laboratorium"},null],"laboratorium":[["^Za dverami ležal mladý drak pripútaný kovovými pásmi.","\n","^Vedľa neho sedel chlapec asi v tvojom veku s kryštálovým kruhom okolo hlavy.","\n","^Obaja sa triasli.","\n","^Muž v bielom plášti zapisoval údaje.","\n","#","^character: Učenec","/#","^„Rezonancia tridsaťdva. Zvýšte tlak.“","\n","ev","str","^Okamžite zasiahnuť.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Najprv ukradnúť výskumné záznamy.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Skontaktovať Nymara cez puto.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"odvaha"},2,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"oslobodit"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"zaznamy"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"volanie"},{"#f":5}]}],null],"zaznamy":["^Lyra stiahla zo stola zväzok papierov.","\n","^Na titulnej strane stálo:","\n","#","^inscription","/#","^PROJEKT KORUNA","\n","^UMELÁ REZONANCIA BEZ DRAČIEHO SÚHLASU","\n","#","^character: Lyra","/#","^„Máme dôkaz.“","\n","^Chlapec znovu vykríkol.","\n","#","^player: Ty","/#","^„Teraz ich dostaneme von.“","\n",{"->":"oslobodit"},null],"volanie":["^Sústredil si sa na Nymara.","\n","^Vzdialenosť bolela.","\n","#","^player: Ty","/#","^„Nymar.“","\n","^Najprv nič.","\n","^Potom teplo.","\n","#","^character: Nymar","/#","^„Viem, kde si.“","\n","#","^player: Ty","/#","^„Ako?“","\n","#","^character: Nymar","/#","^„Pretože si nahnevaný tak hlasno, že ťa počuje polovica kraja.“","\n","^Za mestskými hradbami sa ozval dračí rev.","\n","^Alarm.","\n","#","^character: Taren","/#","^„Predpokladám, že diskrétnosť skončila.“","\n",{"->":"oslobodit"},null],"oslobodit":["^Taren zložil strážcu. Lyra rozbila ovládací kryštál.","\n","^Kovové pásy povolili.","\n","^Mladý drak sa pokúsil postaviť, ale spadol.","\n","^Chlapec si strhol kruh z hlavy.","\n","#","^character: Chlapec","/#","^„Prosím. Nezabíjajte ma.“","\n","#","^player: Ty","/#","^„Kto si?“","\n","#","^character: Chlapec","/#","^„Cael. Dobrovoľník.“","\n","^Lyra naňho neveriacky pozrela.","\n","#","^character: Cael","/#","^„Povedali nám, že Vaelgard si draky necháva pre šľachtu. Že Koruna umožní jazdiť komukoľvek.“","\n","#","^character: Taren","/#","^„A povedali ti, čo to robí drakovi?“","\n","^Cael sa pozrel na zviera.","\n","#","^character: Cael","/#","^„Nie.“","\n",{"->":"unik"},null],"unik":[["^Alarm zaplnil mincovňu.","\n","^Z chodieb prichádzali vojaci.","\n","^Nymar, Sareth a Rok preleteli ponad mestské hradby napriek šípom stráží.","\n","^Strecha laboratória sa roztrhla pod Nymarovými pazúrmi.","\n","#","^character: Nymar","/#","^„Nastúp.“","\n","ev","str","^Vziať Caela so sebou.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Vziať iba dôkazy a zraneného draka.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Zostať ešte chvíľu a zničiť laboratórium.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"sucit"},2,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"let_prec"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"let_prec"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"vzdor"},2,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"znicit_lab"},{"#f":5}]}],null],"znicit_lab":["^Sareth vypustila krátky prúd ohňa cez prázdnu časť haly.","\n","^Kryštálové zariadenia popraskali.","\n","#","^character: Lyra","/#","^„Dúfam, že si si zapamätal, ako sme nemali vyvolať diplomatický incident.“","\n","#","^character: Taren","/#","^„Myslím, že už je diplomatický.“","\n",{"->":"let_prec"},null],"let_prec":["^Vyleteli ste z Arkenu pod paľbou.","\n","^Nymar bol zúrivý.","\n","#","^character: Nymar","/#","^„Oni tomu hovoria Koruna.“","\n","#","^player: Ty","/#","^„Viem.“","\n","#","^character: Nymar","/#","^„Aspoň Vaelgard mal slušnosť nazvať svoju reťaz Kotvou.“","\n","^Za vami zvonili mestské poplachy.","\n","^Pred vami bola dlhá cesta domov.","\n","^A v batožine dôkaz, že niekto práve začal vyrábať jazdcov bez Výberu.","\n","#","^system","/#","^Kapitola VI — Koruna — dokončená.","\n","done",null],"global decl":["ev",0,{"VAR=":"odvaha"},0,{"VAR=":"rozum"},0,{"VAR=":"sucit"},0,{"VAR=":"vzdor"},0,{"VAR=":"puto"},0,{"VAR=":"tajomstvo"},0,{"VAR=":"zranenie"},"str","^","/str",{"VAR=":"drak"},"/ev","end",null]}],"listDefs":{}}