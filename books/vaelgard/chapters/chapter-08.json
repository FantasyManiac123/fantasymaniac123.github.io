{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":["^Na sever ste vyrazili pred úsvitom.","\n","^Svet pod vami postupne mizol pod snehom.","\n","^Prvý deň ste preleteli ponad posledné dediny. Druhý deň zmizli cesty. Tretí deň už pod vami nebolo nič okrem ľadu, skál a tieňov mrakov.","\n","^Edran letel so Serisiným starým drakom Varom.","\n","#","^character: Taren","/#","^„Pripomeň mi, prečo sme zobrali človeka, ktorého sme pred dvoma dňami zatkli.“","\n","#","^character: Lyra","/#","^„Pretože jediný pozná cestu.“","\n","#","^character: Taren","/#","^„To je presne dôvod, prečo zradcovia prežívajú prvé dejstvo.“","\n","^Nymar sa zasmial cez puto.","\n",{"->":"ladovec"},null],"ladovec":["^Na štvrtý deň sa pred vami otvorila trhlina v ľadovci.","\n","^Edran ukázal nadol.","\n","#","^character: Majster Edran","/#","^„Musíme pristáť. Za hrebeňom sa nedá letieť.“","\n","#","^player: Ty","/#","^„Prečo?“","\n","#","^character: Majster Edran","/#","^„Pretože tam vietor nefúka.“","\n","^Taren zamrkal.","\n","#","^character: Taren","/#","^„To znie príjemne.“","\n","#","^character: Majster Edran","/#","^„Nie je.“","\n",{"->":"ticho"},null],"ticho":[["^Za hrebeňom prestal existovať zvuk.","\n","^Nie stíchol.","\n","^Zmizol.","\n","^Nymarove krídla bili vzduch, ale nič si nepočul. Keď Lyra zakričala, videl si pohyb jej úst bez hlasu.","\n","^Potom zmizlo aj puto.","\n","^Prázdnota v hlave bola horšia než bolesť.","\n","^Nymar prudko klesol.","\n","ev","str","^Sústrediť sa na spomienku na prvý let.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Riadiť sa výcvikom a gestami.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Nechať Nymara konať úplne samostatne.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"puto"},2,"+",{"VAR=":"puto","re":true},"/ev",{"->":"spojenie"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"pristatie"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"nymar_sam"},{"#f":5}]}],null],"spojenie":["^Spomenul si si na okamih, keď Nymar prvýkrát otvoril krídla pod tebou.","\n","^Nie na slová.","\n","^Na pocit.","\n","^Na sekundu sa puto vrátilo.","\n","^Nie ako hlas.","\n","^Ako smer.","\n","^Nymar vyrovnal let.","\n",{"->":"pristatie"},null],"nymar_sam":["^Prestaneš sa snažiť viesť.","\n","^Nymar pochopil.","\n","^Bez puta, bez povelov, bez slov si bol iba pasažierom.","\n","^A on drakom.","\n","^Pristál dokonale.","\n","^Keď sa vám po chvíli spojenie vrátilo, cítil si z neho pobavenie.","\n","#","^character: Nymar","/#","^„Mohli by sme to skúšať častejšie.“","\n",{"->":"pristatie"},null],"pristatie":["^Pristáli ste pri čiernych ruinách.","\n","^Zvuk sa pomaly vrátil.","\n","^Pred vami stálo Observatórium Aster.","\n","^Bolo väčšie, než naznačovali legendy.","\n","^Veža vyrastala priamo z ľadovca a na jej vrchole sa nachádzal obrovský bronzový kruh namierený na oblohu.","\n","^Dvere boli otvorené.","\n","#","^character: Lyra","/#","^„To je vždy dobré znamenie.“","\n",{"->":"vnutro"},null],"vnutro":["^Vo vnútri nebol prach.","\n","^Niekto tu bol nedávno.","\n","^Na stole horela olejová lampa.","\n","^Taren vytiahol meč.","\n","#","^character: Taren","/#","^„Máme spoločnosť.“","\n","^Z horného poschodia zišla žena v kožušinovom plášti.","\n","#","^character: Neznáma žena","/#","^„Vaelgard.“","\n","^Edran zbledol.","\n","#","^character: Majster Edran","/#","^„Mara.“","\n","#","^character: Mara","/#","^„Edran.“","\n","^Lyra sa pozrela z jedného na druhého.","\n","#","^character: Lyra","/#","^„Samozrejme, že sa poznajú.“","\n",{"->":"mara"},null],"mara":["^Mara bola poslednou členkou rádu astronómov, ktorí Observatórium strážili.","\n","#","^character: Mara","/#","^„Pred šiestimi nocami sa Tichí objavili za severnou žiarou.“","\n","#","^player: Ty","/#","^„Čo sú?“","\n","#","^character: Mara","/#","^„Nie draky. Nie zvieratá. Možno ani živé bytosti tak, ako tomu rozumieme.“","\n","^Otvorila kovovú schránku.","\n","^Vnútri bol kus čiernej hmoty, ktorá pohlcovala svetlo.","\n","^Nymar cúvol.","\n","#","^character: Nymar","/#","^„To je ono.“","\n","#","^character: Mara","/#","^„Dotkli sa ťa?“","\n","^Nymar prikývol.","\n","^Mara sa pozrela na teba.","\n","#","^character: Mara","/#","^„Potom už vedia cestu k Vaelgardu.“","\n",{"->":"teleskop"},null],"teleskop":[["^Vystúpili ste na vrchol observatória.","\n","^Bronzový kruh nebol teleskop.","\n","^Bol to zosilňovač dračieho vnímania.","\n","^Mara ho aktivovala.","\n","^Nymar sa dotkol čelom kryštálu.","\n","^A ty si videl jeho očami.","\n","^Nie sever.","\n","^Nie oblohu.","\n","^Priestor medzi hviezdami.","\n","^Tam sa pohybovali stovky tmavých tvarov.","\n","^A jeden z nich bol obrovský.","\n","#","^character: Nymar","/#","^„Pozerá sa na nás.“","\n","ev","str","^Okamžite prerušiť spojenie.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Vydržať a skúsiť zistiť viac.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Skúsiť s bytosťou komunikovať.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"prerusenie"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"odvaha"},2,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":"zranenie"},1,"+",{"VAR=":"zranenie","re":true},"/ev",{"->":"pohlad"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev","ev",{"VAR?":"tajomstvo"},2,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"kontakt"},{"#f":5}]}],null],"prerusenie":["^Odtrhol si Nymara od kryštálu.","\n","^Obaja ste spadli na podlahu.","\n","#","^character: Nymar","/#","^„Ďakujem.“","\n","^Mara však hľadela na prístroj.","\n","#","^character: Mara","/#","^„Už nás zaznamenal.“","\n",{"->":"utok"},null],"pohlad":["^Vydržal si.","\n","^Obraz sa priblížil.","\n","^Obrovský Tichý nebol jedna bytosť.","\n","^Bol zhlukom tisícov menších.","\n","^Uprostred nich bolo svetlo.","\n","^Niečo, čo poznáš.","\n","^Kotva.","\n","#","^player: Ty","/#","^„Oni majú Kotvu.“","\n","^Edran zavrel oči.","\n","#","^character: Majster Edran","/#","^„Nie. My máme ich.“","\n",{"->":"utok"},null],"kontakt":["^Namiesto ústretového slova si vyslal cez Nymara jednoduchú otázku.","\n","^Prečo?","\n","^Odpoveď neprišla v slovách.","\n","^Prišiel obraz.","\n","^Draky letiace medzi hviezdami.","\n","^Mestá horiace.","\n","^Kotvy vyrastajúce ako ihly.","\n","^A potom jediný pocit:","\n","^STRATA.","\n","^Nymar sa odtrhol od kryštálu.","\n","#","^character: Nymar","/#","^„Oni nás nenávidia.“","\n","#","^player: Ty","/#","^„Prečo?“","\n","#","^character: Nymar","/#","^„Myslia si, že sme im niečo ukradli.“","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"utok"},null],"utok":["^Všetky lampy zhasli.","\n","^Vonku prestal fúkať vietor.","\n","^Mara vytiahla meč.","\n","#","^character: Mara","/#","^„Prišli.“","\n","^Na oblohe sa objavil prvý Tichý.","\n","^Vyzeral ako diera vyrezaná do sveta.","\n","^Sareth vypustila oheň.","\n","^Plameň zmizol skôr, než sa bytosti dotkol.","\n","#","^character: Lyra","/#","^„To nie je možné.“","\n","#","^character: Edran","/#","^„Preto sme prehrali prvýkrát.“","\n",{"->":"obrana"},null],"obrana":[["^Tichí klesali k observatóriu.","\n","^Mara ukázala na bronzový kruh.","\n","#","^character: Mara","/#","^„Aster má obranu. Potrebuje však dračiu rezonanciu.“","\n","#","^character: Nymar","/#","^„Kotvu.“","\n","#","^character: Mara","/#","^„Nie. Dobrovoľné spojenie.“","\n","^Šesť drakov sa muselo spojiť cez jazdcov do jedinej siete.","\n","ev","str","^Pripojiť sa bez váhania.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Trvať na tom, aby každý drak výslovne súhlasil.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Hľadať technické riešenie bez spoločného puta.","/str","/ev",{"*":".^.c-2","flg":20},{"c-0":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev","ev",{"VAR?":"puto"},2,"+",{"VAR=":"puto","re":true},"/ev",{"->":"siet"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"sucit"},2,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"suhlas"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"rozum"},2,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"mechanizmus"},{"#f":5}]}],null],"suhlas":["^Každý jazdec sa obrátil na svojho draka.","\n","^Nymar sa dotkol čelom tvojho čela.","\n","#","^character: Nymar","/#","^„Áno.“","\n","^Sareth prikývla Lyre.","\n","^Rok štuchol Tarena tak silno, že skoro spadol.","\n","^Var súhlasil posledný.","\n","^Mara sa usmiala.","\n","#","^character: Mara","/#","^„Takto to malo fungovať od začiatku.“","\n",{"->":"siet"},null],"mechanizmus":["^Lyra s Edranom našli staré vedenia pod podlahou.","\n","^Aster nepotreboval ovládnuť drakov. Potreboval iba zosúladiť rytmus kryštálov.","\n","#","^character: Lyra","/#","^„Takže žiadna centrálna Kotva.“","\n","#","^character: Edran","/#","^„Presne.“","\n","#","^player: Ty","/#","^„Sieť bez pána.“","\n","^Edran prikývol.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"siet"},null],"siet":["^Keď sa spojenie otvorilo, prvýkrát si necítil iba Nymara.","\n","^Cítil si Sareth.","\n","^Roka.","\n","^Vara.","\n","^A ďalších drakov.","\n","^Nie ich myšlienky. Ich prítomnosť.","\n","^Bronzový kruh sa rozžiaril.","\n","^Tichí sa zastavili.","\n","^Potom svet explodoval do bieleho svetla.","\n",{"->":"po_utoku"},null],"po_utoku":["^Prebral si sa v snehu.","\n","^Observatórium stále stálo.","\n","^Tichí zmizli.","\n","^Nymar ležal vedľa teba.","\n","#","^player: Ty","/#","^„Nymar?“","\n","^Otvoril jedno oko.","\n","#","^character: Nymar","/#","^„Ak je toto smrť, je veľmi studená.“","\n","^Taren sa zasmial.","\n","^Mara však neoslavovala.","\n","^Pozerala na sever.","\n","#","^character: Mara","/#","^„To bola iba prieskumná skupina.“","\n",{"->":"odhalenie"},null],"odhalenie":["^V podzemí observatória ste našli posledný záznam starého rádu.","\n","^Bol napísaný v dračom jazyku.","\n","^Nymar ho prečítal.","\n","#","^character: Nymar","/#","^„Kotvy nepostavili ľudia.“","\n","^Edran prikývol.","\n","#","^character: Majster Edran","/#","^„Prví draci ich postavili sami.“","\n","#","^player: Ty","/#","^„Prečo by sa sami spútali?“","\n","^Mara položila čierny fragment na stôl.","\n","#","^character: Mara","/#","^„Aby sa skryli pred Tichými.“","\n","^Lyra pochopila prvá.","\n","#","^character: Lyra","/#","^„Puto medzi človekom a drakom nebolo väzenie.“","\n","#","^character: Majster Edran","/#","^„Pôvodne nie.“","\n","#","^character: Nymar","/#","^„Bola to maska.“","\n",{"->":"navrat"},null],"navrat":["^Na spiatočnú cestu ste sa pripravovali v tichosti.","\n","^Vaelgard mal nepriateľa na východe.","\n","^Teraz mal aj nepriateľa na severe.","\n","^A možno boli obe hrozby spojené.","\n","^Pred odletom ti Mara podala malý kryštál z observatória.","\n","#","^character: Mara","/#","^„Aster zachytil ešte jeden signál.“","\n","#","^player: Ty","/#","^„Odkiaľ?“","\n","^Ukázala na juh.","\n","#","^character: Mara","/#","^„Z miesta, kde podľa všetkých máp nič nie je.“","\n","^Nymar roztiahol krídla.","\n","#","^character: Nymar","/#","^„Začínam neznášať miesta, kde podľa máp nič nie je.“","\n","#","^system","/#","^Kapitola VIII — Observatórium Aster — dokončená.","\n","done",null],"global decl":["ev",0,{"VAR=":"odvaha"},0,{"VAR=":"rozum"},0,{"VAR=":"sucit"},0,{"VAR=":"vzdor"},0,{"VAR=":"puto"},0,{"VAR=":"tajomstvo"},0,{"VAR=":"zranenie"},"str","^","/str",{"VAR=":"drak"},"str","^","/str",{"VAR=":"volba_cesty"},"/ev","end",null]}],"listDefs":{}}