{"inkVersion":21,"root":[[{"->":"zaciatok"},["done",{"#n":"g-0"}],null],"done",{"zaciatok":["^Cesta z Asteru trvala päť dní.","\n","^Keď sa na horizonte konečne objavili veže Vaelgardu, čakal si úľavu. Namiesto nej si uvidel vojenský tábor.","\n","^Stovky stanov obkolesovali južnú cestu. Nad nimi viali zástavy troch kráľovstiev.","\n","#","^character: Taren","/#","^„Boli sme preč päť dní.“","\n","#","^character: Lyra","/#","^„Politici sú výkonní, keď ide o paniku.“","\n","^Nymar spomalil.","\n","#","^character: Nymar","/#","^„Cítim veľa drakov. A veľa ľudí, ktorí sa ich boja.“","\n","^Pri pristátí vás čakala Seris.","\n","#","^character: Inštruktorka Seris","/#","^„Rada spojencov prišla rokovať. Arken tvrdí, že ste napadli ich mesto a ukradli štátny výskum.“","\n","#","^player: Ty","/#","^„Unášali draky.“","\n","#","^character: Inštruktorka Seris","/#","^„Preto ešte nezačala vojna.“","\n",{"->":"pred_radou"},null],"pred_radou":[["^Pred vstupom do siene ti Lyra chytila rukáv.","\n","#","^character: Lyra","/#","^„Musíme sa rozhodnúť, čo povieme.“","\n","^V batožine ste mali záznamy Projektu Koruna. V hlave si mal spomienku na Tichých. A niekde na severe zostala Mara s dôkazom, že celý príbeh Kotvy bol nesprávny.","\n","ev",{"VAR?":"tajomstvo"},6,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Vďaka tomu, čo si počas posledných mesiacov zistil, si videl súvislosť, ktorú ostatní zatiaľ prehliadali: Koruna aj Aster pracovali s rovnakým princípom rezonancie.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":".^.^.^.15"},null]}],"nop","\n","ev","str","^Predložiť rade všetko — Korunu, Tichých aj skutočný pôvod Kotiev.","/str",{"VAR?":"tajomstvo"},5,">=","/ev",{"*":".^.c-0","flg":21},"ev","str","^Ukázať iba dôkazy proti Arkenu.","/str","/ev",{"*":".^.c-1","flg":20},"ev","str","^Požiadať, aby pred radou prehovoril Nymar ako rovnocenný svedok.","/str",{"VAR?":"puto"},5,">=","/ev",{"*":".^.c-2","flg":21},"ev","str","^Najprv hovoriť s Caelom a zistiť, či je ochotný svedčiť.","/str",{"VAR?":"sucit"},5,">=","/ev",{"*":".^.c-3","flg":21},{"c-0":["\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"uplna_pravda"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"politicka_hra"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"nymar_pred_radou"},{"#f":5}],"c-3":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"cael"},{"#f":5}]}],null],"cael":["^Cael, dobrovoľník Projektu Koruna, býval pod dohľadom v nemocničnom krídle.","\n","^Keď si vošiel, čakal, že ho budeš obviňovať.","\n","#","^character: Cael","/#","^„Ak poviem pravdu, doma ma označia za zradcu.“","\n","#","^player: Ty","/#","^„A ak ju nepovieš?“","\n","^Pozrel cez okno na Nymara.","\n","#","^character: Cael","/#","^„Potom budú robiť ďalších jazdcov.“","\n","ev",{"VAR?":"sucit"},7,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","#","^player: Ty","/#","^„Nemusíš byť hrdina. Stačí, ak povieš, čo si videl.“","\n","^Cael pomaly prikývol.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"cael_svedci"},{"->":"cael.28"},null]}],[{"->":".^.b"},{"b":["\n","^Cael zaváhal.","\n","ev","str","^Sľúbiť mu ochranu Vaelgardu.","/str","/ev",{"*":".^.c-0","flg":20},"ev","str","^Netlačiť naňho.","/str","/ev",{"*":".^.c-1","flg":20},{"->":"cael.28"},{"c-0":["\n","ev",{"VAR?":"sucit"},1,"+",{"VAR=":"sucit","re":true},"/ev",{"->":"cael_svedci"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"politicka_hra"},{"#f":5}]}]}],"nop","\n",null],"cael_svedci":["^Cael súhlasil.","\n","^To zmenilo všetko.","\n","^Neboli ste už iba kadeti obviňujúci cudzie kniežatstvo. Mali ste človeka, ktorý sa Projektu Koruna zúčastnil dobrovoľne.","\n",{"->":"rada"},null],"nymar_pred_radou":["#","^player: Ty","/#","^„Nebudem hovoriť za Nymara.“","\n","^Seris zdvihla obočie.","\n","#","^player: Ty","/#","^„Ak rokujú o drakoch, nech počujú draka.“","\n","^Nymar sa na teba dlho díval.","\n","#","^character: Nymar","/#","^„To bude zábavné.“","\n",{"->":"rada"},null],"uplna_pravda":["^Rozhodol si sa nič neskrývať.","\n","^Lyra nevyzerala nadšene.","\n","#","^character: Lyra","/#","^„Ak im povieme o Tichých, môžu spanikáriť.“","\n","#","^player: Ty","/#","^„Ak im to nepovieme, budú sa pripravovať na nesprávnu vojnu.“","\n","^Nymar prikývol.","\n",{"->":"rada"},null],"politicka_hra":["^Dokumenty Koruny stačili na obhajobu vašej výpravy.","\n","^Aspoň si v to dúfal.","\n","^Tichí zatiaľ zostanú tajomstvom malej skupiny.","\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"rada"},null],"rada":["^Veľká sieň bola plná.","\n","^Králi, vyslanci, generáli, jazdci a po prvýkrát aj šesť drakov.","\n","^Vyslanec Arkenu, lord Halvek, vystúpil dopredu.","\n","#","^character: Lord Halvek","/#","^„Vaelgard porušil hranice suverénneho kniežatstva.“","\n","^Lyra položila na stôl dokument Projekt Koruna.","\n","#","^character: Lyra","/#","^„Vaše kniežatstvo unášalo draky.“","\n","^Halvek sa ani nepozrel na papier.","\n","#","^character: Lord Halvek","/#","^„Draky nie sú občania.“","\n","^V sále sa ozvalo zavrčanie.","\n",{"->":"spor"},null],"spor":[["ev",{"VAR?":"puto"},6,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Nymar vykročil dopredu bez toho, aby čakal na tvoje gesto.","\n","#","^character: Nymar","/#","^„Tak čo som?“","\n","^Halvek zbledol.","\n","#","^character: Lord Halvek","/#","^„Zbraň Vaelgardu.“","\n","#","^character: Nymar","/#","^„Zbraň, ktorá sa vás práve pýta otázku.“","\n","^Niekoľko vyslancov sa nervózne obzrelo.","\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"spor.0.6"},null]}],"nop","\n","ev","str","^Rozobrať právne rozpory v Arkenovej obhajobe.","/str",{"VAR?":"rozum"},6,">=","/ev",{"*":".^.c-0","flg":21},"ev","str","^Odmietnuť samotnú predstavu, že štáty môžu vlastniť drakov.","/str",{"VAR?":"vzdor"},6,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^Odovzdať technické záznamy Koruny neutrálnym učencom.","/str",{"VAR?":"tajomstvo"},6,">=","/ev",{"*":".^.c-2","flg":21},"ev","str","^Nechať hovoriť Lyru.","/str","/ev",{"*":".^.c-3","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"pravny_utok"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"vzdor"},2,"+",{"VAR=":"vzdor","re":true},"/ev",{"->":"deklaracia"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"dokaz_koruny"},{"#f":5}],"c-3":["\n",{"->":"lyra_hovori"},{"#f":5}]}],null],"pravny_utok":["^Pripomenul si dohodu z Arkenu, staré zmluvy s Vaelgardom a zákaz násilného vytvárania puta.","\n","^Halvek sa pokúsil tvrdiť, že umelá rezonancia nie je puto.","\n","#","^player: Ty","/#","^„Potom nemôžete zároveň tvrdiť, že výsledkom sú dračí jazdci.“","\n","^Ticho v sále ti povedalo, že zásah bol presný.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":"prestavka"},null],"deklaracia":["#","^player: Ty","/#","^„Celá táto diskusia stojí na otázke, komu patria draky. Odpoveď je nikomu.“","\n","^Generál Merovan sa zamračil.","\n","#","^player: Ty","/#","^„Ani Arkenu. Ani kráľom. Ani Vaelgardu.“","\n","^Tentoraz zavrčali nie draky, ale niektorí ľudia.","\n","^Nymar stál pokojne vedľa teba.","\n","#","^character: Nymar","/#","^„Konečne jednoduchá veta.“","\n",{"->":"prestavka"},null],"dokaz_koruny":["^Neutrálni učenci prešli schémy.","\n","^Jeden z nich po chvíli vstal.","\n","#","^character: Učenec","/#","^„Tieto zariadenia spôsobujú bolesť obom účastníkom. Dlhodobé následky nepoznáme.“","\n","^Halvek stratil časť podpory.","\n",{"->":"prestavka"},null],"lyra_hovori":["^Lyra opísala laboratórium bez jediného zbytočného slova.","\n","^Keď skončila, ukázala krvou poškvrnenú stránku záznamu.","\n","#","^character: Lyra","/#","^„Toto nie je výskum jazdcov. Toto je výroba poslušnosti.“","\n",{"->":"prestavka"},null],"prestavka":[["^Počas prestávky sa situácia zhoršila.","\n","^Na nádvorí niekto napadol Caela.","\n","^Útočník utiekol, ale pri stene zostal nôž so znakom troch hviezd.","\n","ev",{"VAR?":"sucit"},6,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Cael prežil bez vážneho zranenia, pretože si pred zasadnutím požiadal Seris, aby pri ňom nechala stráž.","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":".^.^.^.13"},null]}],[{"->":".^.b"},{"b":["\n","^Cael utrpel ranu do ramena. Nebola smrteľná, ale už nemohol pred radu predstúpiť.","\n","ev",{"VAR?":"zranenie"},1,"+",{"VAR=":"zranenie","re":true},"/ev",{"->":".^.^.^.13"},null]}],"nop","\n","^Nymar zacítil vzduch.","\n","#","^character: Nymar","/#","^„Útočník je stále v akadémii.“","\n","ev","str","^Nasledovať Nymarov čuch a puto.","/str",{"VAR?":"puto"},7,">=","/ev",{"*":".^.c-0","flg":21},"ev","str","^Uzavrieť brány a systematicky prehľadať akadémiu.","/str",{"VAR?":"rozum"},6,">=","/ev",{"*":".^.c-1","flg":21},"ev","str","^Vyraziť za útočníkom okamžite.","/str",{"VAR?":"odvaha"},6,">=","/ev",{"*":".^.c-2","flg":21},"ev","str","^Zostať pri rade. Útok môže byť iba odvedenie pozornosti.","/str","/ev",{"*":".^.c-3","flg":20},{"c-0":["\n",{"->":"lov_nymar"},{"#f":5}],"c-1":["\n",{"->":"pasca"},{"#f":5}],"c-2":["\n",{"->":"prenasledovanie"},{"#f":5}],"c-3":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"hlasovanie"},{"#f":5}]}],null],"lov_nymar":["^Nymar ťa viedol cez kuchyne, nádvorie a starú vežu.","\n","^Puto medzi vami bolo také presné, že si vedel, kedy zacítil stopu ešte skôr, než zdvihol hlavu.","\n","^Našli ste útočníka pri podzemnom východe.","\n","^Nebránil sa.","\n","#","^character: Zajatý agent","/#","^„Koruna už nie je projekt.“","\n","#","^player: Ty","/#","^„Čo teda je?“","\n","#","^character: Zajatý agent","/#","^„Armáda.“","\n",{"->":"varovanie"},null],"pasca":["^Seris uzavrela brány.","\n","^Lyra porovnala zoznam hostí so strážnymi záznamami.","\n","^Jeden sluha neexistoval.","\n","^Našli ste ho v sklade pri severnej bráne.","\n","^V topánke mal zašitý rozkaz.","\n","#","^inscription","/#","^PRVÝ PLUK KORUNY JE PRIPRAVENÝ.","\n","^ČAKAŤ NA SIGNÁL.","\n",{"->":"varovanie"},null],"prenasledovanie":["^Uvidel si tieň miznúť za arkádou.","\n","^Bežal si za ním cez strechy nižšieho krídla.","\n","^Agent skočil na pripraveného koňa.","\n","^Ty si skočil za ním.","\n","^Po krátkom boji ste obaja skončili v blate pri bráne.","\n","^Taren dorazil o chvíľu neskôr.","\n","#","^character: Taren","/#","^„Som urazený, že si začal bezomňa.“","\n","^U agenta ste našli rozkaz.","\n",{"->":"varovanie"},null],"varovanie":["^Správa sa dostala k rade.","\n","^Prvý pluk Koruny.","\n","^Umelo spojení jazdci.","\n","^Pripravení na boj.","\n","^Merovan okamžite žiadal mobilizáciu.","\n","#","^character: Generál Merovan","/#","^„Teraz už nemáme čo riešiť.“","\n","^Vtedy sa ozval hlboký tón.","\n","^Nie zvon.","\n","^Asterov kryštál vo vrecku začal svietiť.","\n","^Nymar stuhol.","\n","#","^character: Nymar","/#","^„Tichí.“","\n",{"->":"hlasovanie"},null],"hlasovanie":[["^Rada mala rozhodnúť medzi vojnou na východe a prípravou na neznámu hrozbu zo severu.","\n","ev",{"VAR?":"tajomstvo"},7,">=","/ev",[{"->":".^.b","c":true},{"b":["\n","^Mal si dostatok dôkazov, aby si vysvetlil, že Koruna svojou rezonanciou môže Tichých priťahovať.","\n","#","^player: Ty","/#","^„Nie sú to dve vojny. Koruna vysiela presne ten druh signálu, ktorý Tichí sledujú.“","\n","^Edran sa postavil.","\n","#","^character: Majster Edran","/#","^„Má pravdu.“","\n","^V sále sa prvýkrát zmenila otázka z „ktorého nepriateľa napadnúť?“ na „ako zabrániť obom katastrofám?“","\n","ev",{"VAR?":"tajomstvo"},1,"+",{"VAR=":"tajomstvo","re":true},"/ev",{"->":".^.^.^.8"},null]}],"nop","\n","ev","str","^Navrhnúť spoločnú expedíciu k zdroju južného signálu.","/str",{"VAR?":"tajomstvo"},7,">=",{"VAR?":"rozum"},6,">=","&&","/ev",{"*":".^.c-0","flg":21},"ev","str","^Žiadať vznik samostatnej Dračej rady.","/str",{"VAR?":"vzdor"},7,">=",{"VAR?":"puto"},6,">=","&&","/ev",{"*":".^.c-1","flg":21},"ev","str","^Podporiť obranu Vaelgardu a odložiť útok.","/str","/ev",{"*":".^.c-2","flg":20},"ev","str","^Podporiť zásah proti Projektu Koruna.","/str","/ev",{"*":".^.c-3","flg":20},{"c-0":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"treti_cesta"},{"#f":5}],"c-1":["\n","ev",{"VAR?":"vzdor"},1,"+",{"VAR=":"vzdor","re":true},"/ev","ev",{"VAR?":"puto"},1,"+",{"VAR=":"puto","re":true},"/ev",{"->":"dracia_rada"},{"#f":5}],"c-2":["\n","ev",{"VAR?":"rozum"},1,"+",{"VAR=":"rozum","re":true},"/ev",{"->":"obrana"},{"#f":5}],"c-3":["\n","ev",{"VAR?":"odvaha"},1,"+",{"VAR=":"odvaha","re":true},"/ev",{"->":"vojna"},{"#f":5}]}],null],"dracia_rada":["^Návrh vyvolal chaos.","\n","^Niekoľko šľachticov odišlo zo siene.","\n","^Ale draky zostali.","\n","^Avar sa postavil.","\n","#","^character: Rektor Avar","/#","^„Vaelgard vznikol ako dohoda dvoch druhov. Ak jedna strana nemá hlas, dohoda je fikcia.“","\n","^Hlasovanie prešlo o jediný hlas.","\n","^Prvýkrát v dejinách vznikla Dračia rada.","\n","^Nymar sa k tebe naklonil.","\n","#","^character: Nymar","/#","^„Teraz už len musíme prežiť, aby mala zmysel.“","\n",{"->":"koniec"},null],"treti_cesta":["^Rada schválila prieskum južného signálu.","\n","^Nie ako útek pred vojnou, ale ako pokus pochopiť spojenie medzi Korunou, Kotvami a Tichými.","\n","^Mara mala pravdu.","\n","^Na juhu bolo miesto, ktoré nebolo na žiadnej mape.","\n","^A vy ste tam mali letieť.","\n",{"->":"koniec"},null],"obrana":["^Vaelgard začal opevňovať hory.","\n","^Draky hliadkovali dobrovoľne, nie na rozkaz.","\n","^Napätie však rástlo.","\n","^Na východe sa zhromažďoval Prvý pluk Koruny.","\n","^Na severe mizli hviezdy.","\n",{"->":"koniec"},null],"vojna":["^Rada schválila obmedzený zásah proti základniam Koruny.","\n","^Merovan sa konečne usmial.","\n","^Nymar nie.","\n","#","^character: Nymar","/#","^„Keď ľudia povedia obmedzená vojna, ako často zostane obmedzená?“","\n","^Nemal si odpoveď.","\n",{"->":"koniec"},null],"koniec":["^V tú noc si stál s Nymarom na najvyššej terase.","\n","^Pod vami horeli stovky táborových ohňov.","\n","^Nad vami chýbali tri hviezdy.","\n","#","^character: Nymar","/#","^„Keď si prišiel do Vaelgardu, chcel si byť jazdcom?“","\n","#","^player: Ty","/#","^„Myslel som si, že áno.“","\n","#","^character: Nymar","/#","^„A teraz?“","\n","^Pozrel si na akadémiu, armády a temnú oblohu.","\n","^Odpoveď už nebola jednoduchá.","\n","#","^system","/#","^Kapitola IX — Rada popola — dokončená.","\n","done",null],"global decl":["ev",0,{"VAR=":"odvaha"},0,{"VAR=":"rozum"},0,{"VAR=":"sucit"},0,{"VAR=":"vzdor"},0,{"VAR=":"puto"},0,{"VAR=":"tajomstvo"},0,{"VAR=":"zranenie"},"str","^","/str",{"VAR=":"drak"},"str","^","/str",{"VAR=":"volba_cesty"},"/ev","end",null]}],"listDefs":{}}